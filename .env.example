# Entur krever at alle klienter identifiserer seg. Format: "firma-applikasjon".
# Dette er IKKE en hemmelighet - bare en identifikator. Uidentifiserte klienter
# blir rate-limitet hardt.
ET_CLIENT_NAME=dittnavn-togkart

# Hvor ofte backend faktisk spor Entur. Frontend spor backend hvert 15. sek,
# men alle faner deler samme cache.
CACHE_TTL_SECONDS=10

# Hvor ofte rutedata for tog UTEN malt posisjon hentes fra Journey Planner.
# Posisjonene regnes ut hver gang uansett - dette styrer bare nettverkskallene.
#
# Sto pa 20 fram til 21. august, da beregningen gjaldt SJ alene og hentingen
# tok drojt et sekund. Na dekker den hele landet: rundt 250 turer fra 36
# knutepunkter, malt til 2-3 sekunder. Hentingen skjer bak lasen i
# get_snapshot(), sa hvert kall er tid en besokende venter. 60 er valgt fordi
# rutedata endrer seg i minuttskala - selve posisjonene er ferske uansett,
# siden de regnes ut pa nytt ved hver foresporsel.
SJ_TTL_SECONDS=60

# Hvor lenge et tog blir staende i kartet etter at turen er over.
#
# Et kjoretoy slutter ikke a sende nar det ankommer endestasjonen - det rygger
# inn pa hensettingsanlegget, og GPS-en folger med. Malt natt til 22. august
# var 8 av 15 tog i feeden ferdige med turen sin. RE10 339 sto fire kilometer
# nord for Lillehammer, pa Hovemoen, merket "6 min 12 s forsinket". Bane NOR
# tegner dem ikke, og det er riktig: de er ikke tog i trafikk.
#
# Spokelsesfilteret pa alder fanger dem ikke - de sender helt fint. De to
# filtrene svarer pa hver sin ting.
#
# Nadetiden er der for at en ankomst ikke skal blinke ut mens man ser pa den.
# Sett den til 0 for a skjule med en gang.
FERDIG_NADETID_SEKUNDER=300

# Hvor lenge historikkanalysene (operatorrangering og rushtidsprofil) caches.
# De leser SQLite og regner medianer, og svaret endrer seg i timesskala -
# derfor mye lengre enn togposisjonene.
STATISTIKK_TTL_SECONDS=300

# Hvor lenge driftsmeldingene (nyhetsstripa) caches. Svaret fra Entur er stort
# og endrer seg i minuttskala - tettere polling gir bare samme svar en gang til.
AVVIK_TTL_SECONDS=60

# Hvor lenge stasjonssøket caches. Stasjonsnavn endrer seg ikke i løpet av en
# dag; dette sparer Entur-kall mens noen skriver "Oslo S" bokstav for bokstav.
SOK_TTL_SECONDS=600

# "prod" slår av den interaktive API-dokumentasjonen på /api/docs. La den stå
# uendret lokalt - dokumentasjonen er nyttig når du utvikler.
TOGKART_MILJO=utvikling

# ---------------------------------------------------------------------------
# Ratebegrensning (strupe.py)
# ---------------------------------------------------------------------------

# Sett til "av" for å slå av strupingen helt. La den stå på. Den er en
# bakstopper bak Cloudflare-reglene i drift/cloudflare.md, og den inneholder
# det eneste vernet Cloudflare IKKE kan gi deg: et tak på utgående kall til
# Entur, som henger på ET_CLIENT_NAME og ikke på den besøkendes IP.
TOGKART_STRUPE=på

# MÅ settes til 1 i produksjon bak Cloudflare Tunnel, og bare der.
#
# cloudflared kobler seg til fra 127.0.0.1, så uten denne kommer ALLE
# forespørsler fra samme adresse og strupen teller hele internett i én
# bøtte - som strupte alle besøkende samtidig, første gang noen hamret.
# Med den leses CF-Connecting-IP, men bare når forespørselen faktisk kom
# fra loopback. Se drift/cloudflare.md punkt 0.
# TOGKART_BAK_CLOUDFLARE=1

# ---------------------------------------------------------------------------
# Historikkens levetid (vedlikehold.py)
# ---------------------------------------------------------------------------

# Hvor lenge råobservasjonene lever. Døgnarkivet (tabellen `dogn`) slettes
# aldri, uansett hva som står her - det er tellinger og medianer per døgn,
# operatør og linje, og koster noen få MB i året.
#
# Må være minst like høyt som taket på `dager` i app.py (MAKS_DAGER = 90).
# Er den lavere, svarer ?dager=90 med færre døgn enn det ble spurt om, uten
# å si fra. Appen advarer i loggen ved oppstart hvis de spriker.
HISTORIKK_BEHOLD_DAGER=90

# Når vedlikeholdsjobben kjører, i norsk lokaltid. Klokka fire om natta er
# etter nattogene og før morgenrushet.
VEDLIKEHOLD_TIME=4

# Hvor lenge en tilkobling venter på at en annen skal slippe låsen, i
# sekunder. Databasen kjører i WAL, så lesere og skrivere sperrer normalt
# ikke for hverandre - dette dekker de tilfellene der to skrivere møtes,
# typisk snapshot-loggingen og vedlikeholdsjobben.
HISTORIKK_LAAS_TIMEOUT=5.0

# ---------------------------------------------------------------------------
# Bakgrunnsjobben som holder historikken i gang
# ---------------------------------------------------------------------------

# Hvor ofte appen henter et snapshot av seg selv, uavhengig av om noen ser på
# kartet. Til 14. september ble historikken bare skrevet når en nettleser var
# åpen, og da fikk døgnet hull der ingen så på.
#
# 60 sekunder er ikke tilfeldig valgt. `logg_snapshot` skriver når et tog har
# flyttet seg over 50 m, og et tog i 100 km/t gjør det på under to sekunder -
# så ved ethvert intervall over ti sekunder logges praktisk talt hvert tog ved
# hver runde. Det er altså DETTE TALLET, ikke trafikken, som bestemmer hvor
# stor databasen blir:
#
#     hvert 10. sekund   ~864 000 rader/døgn    20 GB på 90 dager
#     hvert 60. sekund   ~144 000 rader/døgn   3,3 GB
#
# Observasjonene fra august ligger på én per tog hvert 49. sekund i snitt, så
# 60 holder datatettheten på det analyse.py allerede er innstilt på.
TOGKART_POLLER_SEKUNDER=60

# Nødbryter. Sett til "av" hvis jobben skal stoppes uten en utrulling. Merk at
# historikken da får hull igjen - og hull kan ikke fylles i ettertid.
TOGKART_POLLER=på

# Hvor lenge et tog huskes i minnet etter at det sist var i et snapshot.
# Kostnaden ved å glemme for tidlig er nøyaktig én ekstra rad; kostnaden ved å
# glemme for sent er noen kilobyte i en prosess som kjører i månedsvis.
HISTORIKK_GLEMSEL_SEKUNDER=3600


# Hvor gamle tallene får være før /api/health henter fra Entur på nytt.
# Sekunder, standard 300.
#
# Dette skiller en helsesjekk fra en last. CACHE_TTL_SECONDS er ti sekunder,
# tilpasset en nettleser som poller hvert femtende. Leste helsesjekken den
# grensen, ville hver eneste sjekk utløst en full Entur-henting - Vehicle
# Positions, Journey Planner, rutedata for togene uten GPS og en skriving til
# historikk.db. Målt: 2,3 sekunder kaldt mot 1,5 millisekunder varmt.
#
# Sett den ikke ned mot CACHE_TTL_SECONDS. Da blir overvakingen din den
# tyngste trafikken appen har, og den teller pa Entur-kvoten.
# TOGKART_HELSE_TTL=300
