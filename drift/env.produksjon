# Produksjonskonfigurasjon for TogKart.
#
# DENNE FILA GJØR INGENTING DER DEN LIGGER. Den er en mal, ikke en aktiv
# konfigurasjon: `load_dotenv()` i app.py leser `.env` i prosjektroten, og
# ingenting annet. Kopier innholdet til serveren når den finnes:
#
#     scp drift/env.produksjon togkart@m720q:/opt/togkart/.env
#
# Den ligger i `drift/` og ikke som `.env.produksjon` i roten nettopp for at
# ingen skal kunne gjøre den aktiv ved et uhell. Se `tunnel-og-tjeneste.md`.
#
# Ingenting her er hemmelig. `ET_CLIENT_NAME` er en identifikator, ikke en
# nøkkel - den står i `.env.example` også. Derfor kan fila ligge i git.

# ---------------------------------------------------------------------------
# Identitet mot Entur
# ---------------------------------------------------------------------------
ET_CLIENT_NAME=vegard-togkart

# ---------------------------------------------------------------------------
# Miljø
# ---------------------------------------------------------------------------

# Slår av /api/docs, /api/redoc og /openapi.json. De er et utmerket verktøy
# mens du utvikler, og en gratis kartlegging av angrepsflaten når appen står
# ute.
TOGKART_MILJO=prod

# ---------------------------------------------------------------------------
# Ratebegrensning
# ---------------------------------------------------------------------------

# DEN VIKTIGSTE LINJA I FILA, og den eneste som er FARLIG å sette lokalt.
#
# Bak Cloudflare Tunnel kobler `cloudflared` seg til uvicorn fra maskinens
# egen loopback. Sett fra appen kommer derfor ALLE forespørsler fra
# 127.0.0.1, og uten denne ville strupen telt hele internett i én bøtte - som
# strupte samtlige besøkende i det øyeblikket noen hamret.
#
# Med den leses `CF-Connecting-IP`, som Cloudflare setter. Men bare når
# forespørselen faktisk kom fra loopback, og det er halve poenget: uten den
# betingelsen kunne hvem som helst som når porten direkte sendt en ny
# `CF-Connecting-IP` per forespørsel og aldri møtt en grense.
#
# Og derfor skal den IKKE stå i den lokale `.env`-en. Der er det ingen
# Cloudflare foran, alt kommer fra loopback uansett, og flagget ville gjort
# nøyaktig den forfalskningen mulig som det er ment å hindre.
#
# Sjekk etter utrulling:  curl -s https://togkartet.no/api/health
#                         -> "strupe": { "bakCloudflare": true, ... }
TOGKART_BAK_CLOUDFLARE=1

# Sett til "av" bare hvis du feilsøker. Bakstopperen inneholder det eneste
# vernet Cloudflare ikke kan gi deg: taket på utgående kall til Entur.
TOGKART_STRUPE=på

# ---------------------------------------------------------------------------
# Databasen
# ---------------------------------------------------------------------------

# UT av containerens skrivelag. Ligger filen inne, forsvinner all historikk
# neste gang du bygger på nytt, og den kan ikke gjenskapes.
#
# Merk: databasen er tre filer i WAL-modus (.db, -wal, -shm), og den skal
# IKKE ligge på et nettverksdrev - WAL trenger delt minne, og over SMB eller
# NFS faller SQLite stille tilbake til `delete`. Appen advarer i loggen.
HISTORIKK_DB=/var/lib/togkart/historikk.db

# Hvor lenge råobservasjonene lever. Døgnarkivet (`dogn`) slettes aldri.
# Må være minst like høyt som MAKS_DAGER i app.py, som er 90 - ellers svarer
# ?dager=90 med færre døgn enn det ble spurt om, uten å si fra. Appen advarer
# i loggen ved oppstart hvis de spriker.
HISTORIKK_BEHOLD_DAGER=90

# Når vedlikeholdsjobben kjører, norsk lokaltid. Etter nattogene, før rushet.
VEDLIKEHOLD_TIME=4

HISTORIKK_LAAS_TIMEOUT=5.0

# ---------------------------------------------------------------------------
# Bakgrunnsjobben som holder historikken i gang
# ---------------------------------------------------------------------------

# Hvor ofte appen henter et snapshot av seg selv, uavhengig av om noen ser på
# kartet. Til 14. september ble historikken bare skrevet når en nettleser var
# åpen, og da fikk døgnet hull der ingen så på.
#
# 60 sekunder er ikke tilfeldig valgt. `logg_snapshot` skriver når et tog har
# flyttet seg over 50 m, og et tog i 100 km/t gjør det på under to sekunder -
# så ved ethvert intervall over ti sekunder logges praktisk talt hvert tog ved
# hver runde. Det er altså DETTE TALLET, ikke trafikken, som bestemmer hvor
# stor databasen blir:
#
#     hvert 10. sekund   ~864 000 rader/døgn    20 GB på 90 dager
#     hvert 60. sekund   ~144 000 rader/døgn   3,3 GB
#
# Observasjonene fra august ligger på én per tog hvert 49. sekund i snitt, så
# 60 holder datatettheten på det analyse.py allerede er innstilt på.
TOGKART_POLLER_SEKUNDER=60

# Nødbryter. Sett til "av" hvis jobben skal stoppes uten en utrulling. Merk at
# historikken da får hull igjen - og hull kan ikke fylles i ettertid.
TOGKART_POLLER=på

# Hvor lenge et tog huskes i minnet etter at det sist var i et snapshot.
# Kostnaden ved å glemme for tidlig er nøyaktig én ekstra rad; kostnaden ved å
# glemme for sent er noen kilobyte i en prosess som kjører i månedsvis.
HISTORIKK_GLEMSEL_SEKUNDER=3600


# ---------------------------------------------------------------------------
# Cacher
# ---------------------------------------------------------------------------
# Samme verdier som lokalt. Belastningen mot Entur vokser ikke med trafikken -
# alle besøkende deler ett kall - så disse styrer ferskhet, ikke kostnad.
CACHE_TTL_SECONDS=10
SJ_TTL_SECONDS=60
AVVIK_TTL_SECONDS=60

# Nådetid før et tog som har fullført turen tas ut av kartet. Se
# `.env.example` for målingen bak tallet.
FERDIG_NADETID_SEKUNDER=300
STATISTIKK_TTL_SECONDS=300
SOK_TTL_SECONDS=600
